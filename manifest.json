{
  "manifest_version": 3,
  "name": "X Gợi Ý Bình Luận",
  "version": "1.0.0",
  "description": "Thêm nút \"Gợi ý bình luận\" vào mỗi bài trên X. Bạn chọn câu, extension điền vào ô trả lời, bạn tự bấm Thích và Trả lời.",
  "permissions": ["storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://api.groq.com/*", "https://pbs.twimg.com/*", "https://api.anthropic.com/*", "http://localhost:11434/*", "http://127.0.0.1:11434/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["templates.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "X Gợi Ý Bình Luận",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
